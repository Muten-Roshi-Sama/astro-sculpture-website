---
import Layout from "@/layouts/Layout.astro";
import HomeMob from "@/components/HomeMob.astro";
import VerticalCarousel from "@/components/react/VerticalCarousel";
import { getCollection } from 'astro:content';

const sculptures = await getCollection('collection');

// On ajoute "/assets" ici, uniquement pour le composant React
const carouselImages = sculptures.map((sculpture) => ({
  src: `/assets${sculpture.data.heroImage}`, 
  alt: sculpture.data.title,
}));
---

<Layout>
  <div class="md:flex-row flex flex-col md:gap-10 relative md:pr-72 grow">
    <div class="relative hidden md:flex flex-1">
      <h2 class="max-w-96 text-6xl md:text-8xl absolute text-center z-20 right-0 bottom-1/3 font-fugaz leading-tight">
        Deborah<br />Toussaint
      </h2>
      <p class="text-xl absolute bottom-1/4 right-0">Sculptrice</p>
    </div>
    <HomeMob />

    <div class="min-h-screen md:w-1/2 -mt-50 md:mt-0 max-h-full overflow-hidden">
      <VerticalCarousel client:visible images={carouselImages} />
    </div>
  </div>
</Layout>