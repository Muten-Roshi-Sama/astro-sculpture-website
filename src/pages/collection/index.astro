---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import CardLanding from "@/components/ui/CardLanding.astro";
import Destacado from "@/components/ui/Destacado.astro";

const posts = (await getCollection("collection")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
  <section
    class="overflow-hidden md:h-[calc(100vh-80px)] md:px-6 flex md:flex-row flex-col-reverse w-full"
  >
    <!-- On utilise h-full pour que les deux colonnes aient la même hauteur -->
    <div class="grid md:grid-cols-2 gap-x-6 w-full h-full">
      
      <!-- Colonne de gauche (Destacado) -->
      <div class="h-full w-full">
        <Destacado post={posts[0]} />
      </div>

      <!-- Colonne de droite (Liste). J'ai retiré le py-10 qui décalait le haut -->
      <ul
        class="flex flex-col gap-6 p-2 overflow-y-scroll no-scrollbar h-full"
      >
        {posts.map((post) => <CardLanding post={post} />)}
      </ul>
    </div>

    <!-- Titre Collection. J'ai réduit text-9xl à text-7xl -->
    <div
      class="text-4xl max-w-72 md:max-w-none md:text-7xl md:h-full w-20 relative mr-10 shrink-0"
    >
      <p class="md:rotate-90 mt-40 md:text-nowrap font-fugaz">Collection</p>
    </div>
  </section>
</Layout>