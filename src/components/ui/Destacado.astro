---
interface Props {
  post: any;
}
const { post } = Astro.props;
const hero = post?.data?.heroImage as string;
const basePath = hero 
  ? (hero.startsWith("/assets") ? hero : `/assets${hero.startsWith("/") ? hero : `/${hero}`}`)
  : "";
---

<a
  href={`/blog/${post.id}/`}
  class="relative block w-full h-full group overflow-hidden"
>
  {
    basePath && (
      <img
        src={basePath}
        alt={post.data.title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="eager"
        decoding="async"
      />
    )
  }
  <div class="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-black/80 to-transparent">
    <h2 class="text-3xl text-white font-bold">{post.data.title}</h2>
  </div>
</a>